# ---------------------------------------------------------------------------
# B&M Field App — environment variables
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# The setup guides in /docs tell you exactly where each value comes from.
# ---------------------------------------------------------------------------

# --- Supabase (from your Supabase project → Project Settings → API) ---------
# Safe to expose to the browser (the PWA uses these):
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server only. Grants full DB access, bypasses RLS.
# Lives ONLY in the API service env on Render. Never ships to the phone/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Weekly backup job (API service only) -----------------------------------
# SECRET. Lets the unattended weekly backup read the export routes (backup zip,
# rate cards, field reports) without borrowing an admin's login. Read-only — it
# cannot create, edit, or complete anything.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Leave it unset and the automation door simply
# does not exist; the export routes stay admin-session-only.
BACKUP_TOKEN=

# --- Web PWA (Vite needs the VITE_ prefix to expose to the browser) ---------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_BASE_URL=https://bm-field-api.onrender.com

# --- API service ------------------------------------------------------------
PORT=8080
# Comma-separated list of allowed browser origins (your web app URL).
CORS_ORIGINS=http://localhost:5173,https://bm-field-web.onrender.com

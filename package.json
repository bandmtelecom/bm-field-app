{
  "name": "bm-field-app",
  "version": "0.2.8",
  "private": true,
  "description": "B&M Telecom field reporting + auto-invoicing PWA (Supabase + Render)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:billing": "npm run build --workspace @bm/billing",
    "test:billing": "npm run test --workspace @bm/billing",
    "test": "npm run test --workspace @bm/billing",
    "dev:web": "npm run dev --workspace @bm/web",
    "build:web": "npm run build --workspace @bm/web",
    "dev:api": "npm run dev --workspace @bm/api",
    "build:api": "npm run build --workspace @bm/api",
    "build": "npm run build:billing && npm run build:api && npm run build:web"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
